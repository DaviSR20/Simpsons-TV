{
  "expo": {
    "name": "Simpsons TV Mobile",
    "slug": "simpsons-tv-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "La app necesita la cámara para escanear el QR de la Raspberry."
      }
    },
    "android": {
      "permissions": [
        "CAMERA"
      ]
    }
  }
}
